/**
 * ClicVote — Règles Cloud Storage
 *
 * Les visuels des concours et les portraits des candidats sont hébergés sur
 * Cloudinary. Ce bucket ne sert plus qu'aux contenus historiques : lecture
 * publique, aucune écriture depuis le client.
 *
 * Déploiement (uniquement si Cloud Storage est activé sur le projet) :
 *   firebase deploy --only storage
 */
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
