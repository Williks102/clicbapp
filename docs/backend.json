{
  "entities": {
    "Competition": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Competition",
      "type": "object",
      "description": "Concours ouvert au vote du public, éventuellement diffusé en direct.",
      "properties": {
        "id": { "type": "string", "description": "Identifiant unique du concours." },
        "organizerId": {
          "type": "string",
          "description": "Organisateur propriétaire. (Relation : Organizer 1:N Competition)"
        },
        "organizerName": { "type": "string", "description": "Nom affiché de l'organisateur." },
        "title": { "type": "string", "description": "Titre public du concours." },
        "category": { "type": "string", "description": "Catégorie du concours." },
        "description": { "type": "string", "description": "Présentation détaillée." },
        "coverImage": { "type": "string", "description": "URL Cloudinary de la bannière.", "format": "uri" },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "voting", "closed", "finished"],
          "description": "Cycle de vie du concours. Seul 'voting' autorise l'enregistrement de votes."
        },
        "votingStartsAt": { "type": "string", "format": "date-time" },
        "votingEndsAt": { "type": "string", "format": "date-time" },
        "hideResults": {
          "type": "boolean",
          "description": "Masque le classement public jusqu'à la proclamation."
        },
        "winnerCandidateId": { "type": "string", "description": "Candidat déclaré vainqueur." },
        "votePacks": {
          "type": "array",
          "description": "Offres payantes de votes.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "votes": { "type": "number" },
              "price": { "type": "number", "description": "Prix en F CFA." },
              "highlighted": { "type": "boolean" }
            },
            "required": ["id", "name", "votes", "price"]
          }
        },
        "freeVote": {
          "type": "object",
          "description": "Configuration du vote gratuit (modèle hybride).",
          "properties": {
            "enabled": { "type": "boolean" },
            "cooldownHours": {
              "type": "number",
              "description": "Délai avant de pouvoir revoter gratuitement."
            }
          },
          "required": ["enabled", "cooldownHours"]
        },
        "live": {
          "type": "object",
          "description": "Configuration de la diffusion en direct.",
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "type": "string" },
            "provider": {
              "type": "string",
              "enum": ["youtube", "facebook", "vimeo", "hls", "iframe"]
            },
            "url": { "type": "string", "description": "URL du flux fournie par l'organisateur." },
            "isLive": { "type": "boolean", "description": "Piloté depuis la régie." },
            "scheduledAt": { "type": "string", "format": "date-time" },
            "paid": { "type": "boolean" },
            "price": { "type": "number", "description": "Prix d'accès en F CFA." },
            "chatEnabled": { "type": "boolean" },
            "replayUrl": { "type": "string" }
          },
          "required": ["enabled", "isLive", "paid", "price", "chatEnabled"]
        },
        "stats": {
          "type": "object",
          "description": "Compteurs dénormalisés, mis à jour de façon atomique.",
          "properties": {
            "totalVotes": { "type": "number" },
            "freeVotes": { "type": "number" },
            "paidVotes": { "type": "number" },
            "totalRevenue": { "type": "number" },
            "candidatesCount": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "organizerId",
        "title",
        "category",
        "status",
        "votingStartsAt",
        "votingEndsAt",
        "votePacks",
        "freeVote",
        "live",
        "stats"
      ]
    },

    "Candidate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Candidate",
      "type": "object",
      "description": "Participant présenté au vote du public.",
      "properties": {
        "id": { "type": "string" },
        "competitionId": {
          "type": "string",
          "description": "Concours de rattachement. (Relation : Competition 1:N Candidate)"
        },
        "name": { "type": "string" },
        "number": { "type": "number", "description": "Numéro de dossard, unique par concours." },
        "photo": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "city": { "type": "string" },
        "voteCount": { "type": "number", "description": "Total des votes reçus." },
        "freeVoteCount": { "type": "number" },
        "paidVoteCount": { "type": "number" },
        "eliminated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "competitionId", "name", "number", "voteCount", "eliminated"]
    },

    "Vote": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Vote",
      "type": "object",
      "description": "Journal d'un vote. Pour les votes payants, l'identifiant du document est celui de la commande, ce qui rend le webhook idempotent.",
      "properties": {
        "id": { "type": "string" },
        "competitionId": { "type": "string" },
        "candidateId": { "type": "string" },
        "candidateName": { "type": "string" },
        "userId": { "type": "string" },
        "voterEmail": { "type": "string", "format": "email" },
        "voterName": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string", "enum": ["free", "paid"] },
        "orderId": { "type": "string", "description": "Commande à l'origine du vote payant." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "competitionId", "candidateId", "quantity", "type", "createdAt"]
    },

    "FreeVoteClaim": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FreeVoteClaim",
      "type": "object",
      "description": "Suivi anti-fraude du vote gratuit. Identifiant du document : `${userId}_${competitionId}`.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "competitionId": { "type": "string" },
        "lastVotedAt": { "type": "string", "format": "date-time" },
        "totalFreeVotes": { "type": "number" }
      },
      "required": ["id", "userId", "competitionId", "lastVotedAt"]
    },

    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Commande payante. L'identifiant du document sert de référence de paiement Paiement Pro.",
      "properties": {
        "id": { "type": "string", "description": "Référence de paiement." },
        "type": { "type": "string", "enum": ["VOTE_PACK", "LIVE_ACCESS"] },
        "competitionId": { "type": "string" },
        "competitionTitle": { "type": "string" },
        "organizerId": { "type": "string" },
        "candidateId": { "type": "string" },
        "candidateName": { "type": "string" },
        "packId": { "type": "string" },
        "packName": { "type": "string" },
        "votes": { "type": "number" },
        "amount": { "type": "number", "description": "Montant en F CFA, calculé côté serveur." },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "userId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PAID", "FAILED", "FLAGGED", "REFUNDED"],
          "description": "FLAGGED signale une incohérence entre montant payé et montant attendu."
        },
        "paymentDetails": { "type": "object", "description": "Charge utile brute du webhook." },
        "createdAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "type",
        "competitionId",
        "organizerId",
        "amount",
        "customerEmail",
        "status",
        "createdAt"
      ]
    },

    "LiveAccess": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LiveAccess",
      "type": "object",
      "description": "Droit d'accès individuel à une diffusion payante. Identifiant du document : celui de la commande.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "competitionId": { "type": "string" },
        "orderId": { "type": "string" },
        "pricePaid": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "competitionId", "pricePaid", "purchaseDate"]
    },

    "ChatMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ChatMessage",
      "type": "object",
      "description": "Message du chat associé à une diffusion en direct.",
      "properties": {
        "id": { "type": "string" },
        "competitionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string", "enum": ["customer", "organizer", "admin"] },
        "message": { "type": "string", "maxLength": 300 },
        "hidden": { "type": "boolean", "description": "Masqué par la modération." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "competitionId", "userId", "message", "hidden", "createdAt"]
    },

    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Compte utilisateur de la plateforme.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["customer", "organizer", "admin"] },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "chatBanned": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },

    "Organizer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Organizer",
      "type": "object",
      "description": "Profil public d'un organisateur de concours.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name"]
    },

    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Catégorie de concours.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },

  "collections": {
    "competitions": "Competition",
    "candidates": "Candidate",
    "votes": "Vote",
    "freeVoteClaims": "FreeVoteClaim",
    "orders": "Order",
    "liveAccess": "LiveAccess",
    "chatMessages": "ChatMessage",
    "users": "User",
    "organizers": "Organizer",
    "categories": "Category",
    "transactions": "Reversements et remboursements (usage admin)",
    "percentageConfigurations": "Commissions de la plateforme (usage admin)",
    "roles_admin": "Source de vérité des rôles administrateurs"
  },

  "notes": [
    "Toutes les écritures passent par des Server Actions Next.js utilisant le SDK Admin ; le SDK client est en lecture seule (voir firestore.rules).",
    "Les compteurs de votes sont mis à jour par transaction Firestore avec FieldValue.increment, jamais recalculés côté client.",
    "Le webhook de paiement est idempotent : le vote et l'accès live portent l'identifiant de la commande."
  ]
}
