
/**
 * Core Philosophy: This ruleset implements a security model with three primary access levels:
 * 1.  User-Owned Data: User profiles and their associated tickets are strictly private. Only the authenticated owner of the data can perform any action on it. This is enforced for all paths under `/users/{userId}`.
 * 2.  Public-Read, Owner-Write Data: Collections like `organizers` and `events` are publicly readable by anyone, allowing users to browse event details. However, only the authenticated organizer who created the content can modify or delete it.
 * 3.  Role-Based Access Control (RBAC): Global data like `categories`, `ticketTypes`, and `percentageConfigurations` is managed by administrators. The presence of a user's UID in the `/roles_admin` collection grants them administrative privileges for write operations on these collections.
 *
 * Data Structure:
 * - /users/{userId} -> tickets/{ticketId}: Private data owned by a specific user.
 * - /organizers/{organizerId}: Public data managed by a specific organizer (who is also a user).
 * - /events/{eventId}: Public data, writable only by the owning organizer.
 * - /categories, /ticketTypes: Publicly readable master data, writable only by admins.
 * - /percentageConfigurations: Private configuration data, readable and writable only by admins.
 * - /roles_admin: A locked-down collection that serves as the source of truth for identifying admin users.
 *
 * Key Security Decisions:
 * - Admin Role Management: The `/roles_admin` collection is read-only via security rules. Admins must be added or removed manually through the Firebase Console to prevent any client-side escalation of privileges.
 * - No User/Organizer Listing: Top-level listing of `/users` and `/organizers` collections is disabled to protect user privacy and prevent data scraping.
 * - Default Deny: Any path not explicitly matched is denied access. Permissions that are not explicitly granted are also denied.
 *
 * Denormalization for Authorization:
 * To ensure fast and secure rules, authorization data is denormalized. For example, a document in the `/users/{userId}/tickets` subcollection must contain a `userId` field that matches the `{userId}` in the path. Similarly, an `event` document contains an `organizerId`. This avoids costly and slow `get()` calls in rules, making authorization checks efficient.
 *
 * Structural Segregation:
 * While not yet implemented, this ruleset is designed to easily support structural segregation. For example, if "draft" events were needed, they could be placed in a separate, private collection with stricter rules, while public events remain in `/events/{eventId}`.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for concise and readable rules
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(resourceId) {
        return isSignedIn() && resource != null && request.auth.uid == resource.data[resourceId];
    }

    /**
     * Checks if the requesting user has an admin role.
     * The role is granted if a document with the user's UID exists in the /roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isAdminAndExists() {
      return isAdmin() && resource != null;
    }

    /**
     * @description   Protects a user's private profile document.
     * @path          /users/{userId}
     * @allow         A user can read/write their own profile.
     * @allow         Admins can list and read all users.
     * @deny          Regular users cannot list all users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // ✅ Admins peuvent lister les users
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) || isAdmin();

      /**
       * @description   Manages tickets purchased by a specific user.
       * @path          /users/{userId}/tickets/{ticketId}
       */
      match /tickets/{ticketId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    /**
     * @description   Manages organizer profiles.
     * @path          /organizers/{organizerId}
     * @allow         Public read, owner write, admins can list.
     */
    match /organizers/{organizerId} {
      allow get: if true;
      allow list: if isAdmin(); // ✅ Admins peuvent lister les organizers
      allow create: if isOwner(organizerId) && request.resource.data.id == organizerId;
      allow update: if isOwner(organizerId) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(organizerId) || isAdmin();
    }
    
    /**
     * @description   Manages events.
     * @path          /events/{eventId}
     * @allow         Public read, owner write, admins can list all.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true; // ✅ Public peut lister (pour homepage)
      allow create: if isSignedIn() && isOwner(request.resource.data.organizerId);
      allow update: if isExistingOwner('organizerId') || isAdmin();
      allow delete: if isExistingOwner('organizerId') || isAdmin();
    }

    /**
 * @description   Manages ticket sales/purchases.
 * @path          /sales/{saleId}
 * @allow         Authenticated users can create sales (buy tickets).
 * @allow         Customers can read their own sales (by email).
 * @allow         Organizers can read sales for their events (by organizerId).
 * @allow         Admins can read all sales.
 * @deny          Only admins can update or delete sales (for refunds/cancellations).
 * @principle     Customer privacy with organizer access to their event sales.
 */
match /sales/{saleId} {
  // ✅ CREATE: Any authenticated user can create a sale (when purchasing)
  allow create: if isSignedIn() 
                && request.resource.data.customerEmail != null
                && request.resource.data.eventId != null
                && request.resource.data.organizerId != null;
  
  // ✅ GET: Customer (by email) OR Organizer (by organizerId) OR Admin
  allow get: if isSignedIn() && (
                  request.auth.token.email == resource.data.customerEmail  // Customer
                  || request.auth.uid == resource.data.organizerId         // Organizer
                  || isAdmin()                                             // Admin
                );
  
  // ✅ LIST: Authenticated users only (filtered by where() client-side)
  // Client-side queries MUST use where() to filter by customerEmail or organizerId
  allow list: if isSignedIn();
  
  // ✅ UPDATE/DELETE: Admin only (for refunds, cancellations)
  allow update: if isAdmin();
  allow delete: if isAdmin();
}

    /**
     * @description   Manages sales/purchases.
     * @path          /sales/{saleId}
     * @allow         Organizer can read their own sales.
     * @allow         Admins can read/list all sales.
     * @allow         System can create sales (via server).
     */
    match /sales/{saleId} {
      // Lecture : propriétaire de la vente OU organisateur de l'événement OU admin
      allow get: if isSignedIn() && (
        isExistingOwner('organizerId') || 
        isAdmin()
      );
      
      // List : organisateur peut lister ses ventes, admin peut tout lister
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.organizerId ||
        isAdmin()
      );
      
      // Création : n'importe quel utilisateur authentifié peut créer une vente
      // (nécessaire pour le processus d'achat)
      allow create: if isSignedIn() && 
        request.resource.data.organizerId != null &&
        request.resource.data.eventId != null;
      
      // Mise à jour : seulement admin
      allow update: if isAdmin();
      
      // Suppression : seulement admin
      allow delete: if isAdmin();
    }

    /**
     * @description   Stores event categories.
     * @path          /categories/{categoryId}
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdminAndExists();
      allow delete: if isAdminAndExists();
    }

    /**
     * @description   Stores ticket types.
     * @path          /ticketTypes/{ticketTypeId}
     */
    match /ticketTypes/{ticketTypeId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdminAndExists();
      allow delete: if isAdminAndExists();
    }

    /**
     * @description   Stores sensitive configurations.
     * @path          /percentageConfigurations/{configId}
     */
    match /percentageConfigurations/{configId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdminAndExists();
      allow delete: if isAdminAndExists();
    }

    /**
     * @description   Source of truth for admin roles.
     * @path          /roles_admin/{userId}
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}