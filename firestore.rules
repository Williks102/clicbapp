/**
 * ClicVote — Règles de sécurité Firestore
 *
 * Modèle de sécurité
 * ------------------
 * L'authentification de l'application repose sur NextAuth (cookie de session
 * signé), et non sur Firebase Auth : `request.auth` est donc toujours nul pour
 * le SDK client. Par conséquent :
 *
 *  1. Le SDK client est strictement EN LECTURE SEULE. Il ne sert qu'aux
 *     affichages temps réel : classement des candidats, statut du direct et
 *     chat des diffusions.
 *  2. Toutes les écritures (votes, commandes, concours, candidats, messages,
 *     modération) passent par des Server Actions Next.js qui utilisent le SDK
 *     Admin et contournent ces règles après avoir vérifié la session et le rôle
 *     de l'utilisateur.
 *  3. Les collections contenant des données personnelles ou financières
 *     (utilisateurs, votes, commandes, accès aux directs, configurations) sont
 *     totalement inaccessibles depuis le client.
 *
 * Lecture publique
 * ----------------
 * Seules les données destinées à l'affichage public sont lisibles :
 * concours publiés, candidats, catégories, profils d'organisateurs et messages
 * de chat. Les concours en brouillon restent invisibles : les requêtes clientes
 * doivent filtrer sur `status` (voir `where('status', 'in', [...])`), sans quoi
 * la requête est rejetée par la règle `list`.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    /** Un concours est public dès lors qu'il n'est plus en brouillon. */
    function isPublishedCompetition() {
      return resource != null && resource.data.status != 'draft';
    }

    // ==================== CONCOURS ====================

    /**
     * @path   /competitions/{competitionId}
     * @read   Public, hors brouillons.
     * @write  Server Actions uniquement (SDK Admin).
     */
    match /competitions/{competitionId} {
      allow get: if isPublishedCompetition();
      allow list: if isPublishedCompetition();
      allow create, update, delete: if false;
    }

    // ==================== CANDIDATS ====================

    /**
     * @path   /candidates/{candidateId}
     * @read   Public : alimente le classement temps réel.
     * @write  Server Actions uniquement — les compteurs de votes ne doivent
     *         jamais être modifiables depuis le client.
     */
    match /candidates/{candidateId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ==================== CHAT DES DIFFUSIONS ====================

    /**
     * @path   /chatMessages/{messageId}
     * @read   Public : le fil du chat s'affiche pour tous les spectateurs.
     * @write  Server Action `sendChatMessage`, qui vérifie la session,
     *         le bannissement éventuel et applique l'anti-spam.
     */
    match /chatMessages/{messageId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ==================== ORGANISATEURS ====================

    /**
     * @path   /organizers/{organizerId}
     * @read   Fiche publique consultée sur /organizers/[id].
     * @deny   Le listing complet est interdit (protection contre l'aspiration).
     */
    match /organizers/{organizerId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ==================== CATÉGORIES ====================

    /**
     * @path   /categories/{categoryId}
     * @read   Données de référence publiques.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ==================== DONNÉES PRIVÉES ====================

    /**
     * Collections inaccessibles depuis le client : elles contiennent des
     * données personnelles, financières ou décisives pour l'intégrité du
     * scrutin. Elles ne sont manipulées que par le SDK Admin côté serveur.
     *
     * - /users                    profils et rôles
     * - /votes                    journal des votes
     * - /freeVoteClaims           anti-fraude du vote gratuit
     * - /orders                   commandes et détails de paiement
     * - /liveAccess               droits d'accès aux diffusions payantes
     * - /transactions             reversements et remboursements
     * - /percentageConfigurations commissions de la plateforme
     */
    match /users/{userId} {
      allow read, write: if false;
    }

    match /votes/{voteId} {
      allow read, write: if false;
    }

    match /freeVoteClaims/{claimId} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /liveAccess/{accessId} {
      allow read, write: if false;
    }

    match /transactions/{transactionId} {
      allow read, write: if false;
    }

    match /percentageConfigurations/{configId} {
      allow read, write: if false;
    }

    /**
     * @path  /roles_admin/{userId}
     * @note  Source de vérité des rôles administrateurs.
     *        Modifiable uniquement depuis la console Firebase.
     */
    match /roles_admin/{userId} {
      allow read, write: if false;
    }

    // ==================== REFUS PAR DÉFAUT ====================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ==================== FIREBASE STORAGE ====================

service firebase.storage {
  match /b/{bucket}/o {
    /**
     * Les visuels des concours et les portraits des candidats sont hébergés
     * sur Cloudinary. Ce bucket ne sert qu'aux contenus historiques, en
     * lecture seule.
     */
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
